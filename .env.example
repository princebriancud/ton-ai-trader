# TON native asset is represented as 'ton' by STON.fi.
FROM_ASSET=ton
# Required: exact destination jetton address. Do not use a token symbol.
TO_ASSET=
# Required: amount in source asset's smallest units; TON uses nanotons (1 TON = 1000000000).
AMOUNT_UNITS=
SLIPPAGE_TOLERANCE=0.01
MAX_SLIPPAGE_TOLERANCE=0.01
# Live trading intentionally stays disabled in this starter.
LIVE_TRADING_ENABLED=false
